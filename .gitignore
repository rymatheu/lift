# ---------------------------------------------------------------------------
# Generated data, outputs and vendored assets
#
# These three directories are the ones src/lift/paths.py resolves to. Nothing
# in them is source: data/ holds embedding matrices produced by the scripts in
# experiments/, outputs/ holds figures and Potree exports, and vendor/ is
# fetched by scripts/fetch_potree.sh. All of it is reproducible, and none of it
# belongs in git -- a 10 GB set of .npy embeddings committed here once cost the
# repo its entire Git LFS quota.
#
# If you set LIFT_DATA_DIR / LIFT_OUTPUT_DIR / LIFT_VENDOR_DIR to point
# somewhere outside the repo, these rules stop mattering for those paths.
# ---------------------------------------------------------------------------
/data/
/outputs/
/vendor/

# Belt and braces: the large binary formats this project generates, wherever
# they land. Committing one of these is almost always a mistake -- use
# `git add -f <path>` if you genuinely mean to.
*.npy
*.npz
*.las
*.laz
octree.bin
hierarchy.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.gguf

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / type-check / lint caches
.pytest_cache/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------------------------------------------------------------------------
# Secrets and local config
#
# Never commit credentials. Hugging Face tokens in particular -- the models in
# src/lift/models/ are pulled through huggingface_hub.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.toml

# ---------------------------------------------------------------------------
# Editors and OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code: shared project config (.claude/settings.json, skills) is meant
# to be committed; only the per-user override is local.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
*.log
tmp/
scratch/
